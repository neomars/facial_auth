#: pam/pam_facial_auth.c:181
msgid ""
"Turn your head clearly to your right, then to your left, then look at the "
"screen."
msgstr ""
"Tournez nettement la tête vers votre droite, puis vers votre gauche, puis "
"regardez l'écran."

#: pam/pam_facial_auth.c:182
msgid ""
"Turn your head clearly to your left, then to your right, then look at the "
"screen."
msgstr ""
"Tournez nettement la tête vers votre gauche, puis vers votre droite, puis "
"regardez l'écran."

#: pam/pam_facial_auth.c:195 src/facial_auth/cli.py:206
msgid "Good. Now turn your head clearly to your left."
msgstr "Bien. Maintenant, tournez nettement la tête vers votre gauche."

#: pam/pam_facial_auth.c:196 src/facial_auth/cli.py:207
msgid "Good. Now turn your head clearly to your right."
msgstr "Bien. Maintenant, tournez nettement la tête vers votre droite."

#: pam/pam_facial_auth.c:197
msgid "Good. Now look straight at the screen."
msgstr "Bien. Maintenant, regardez l'écran bien en face."

#: pam/pam_facial_auth.c:205
msgid "Head-turn test not completed."
msgstr "Le test de rotation de la tête n'a pas abouti."

#: pam/pam_facial_auth.c:207
msgid "Head-turn test failed."
msgstr "Le test de rotation de la tête a échoué."

#: pam/pam_facial_auth.c:208
msgid "Face not recognized."
msgstr "Visage non reconnu."

#: pam/pam_facial_auth.c:572
msgid "Password: "
msgstr ""

#: pam/pam_facial_auth.c:707
msgid "Looking for your face..."
msgstr "Recherche de votre visage..."

#: pam/pam_facial_auth.c:775
msgid "Looking for your face... (or type your password)"
msgstr "Recherche de votre visage... (ou saisissez votre mot de passe)"

#: pam/pam_facial_auth.c:903
msgid "Face recognized."
msgstr "Visage reconnu."

#: src/facial_auth/cli.py:22
msgid "Look straight at the camera"
msgstr "Regardez droit vers la caméra"

#: src/facial_auth/cli.py:22
msgid "Turn your head slightly to the left"
msgstr "Tournez légèrement la tête vers la gauche"

#: src/facial_auth/cli.py:23
msgid "Turn your head slightly to the right"
msgstr "Tournez légèrement la tête vers la droite"

#: src/facial_auth/cli.py:23
msgid "Tilt your head slightly up"
msgstr "Inclinez légèrement la tête vers le haut"

#: src/facial_auth/cli.py:24
msgid "Tilt your head slightly down"
msgstr "Inclinez légèrement la tête vers le bas"

#: src/facial_auth/cli.py:24
msgid "Look straight again, smile"
msgstr "Regardez à nouveau droit devant, souriez"

#: src/facial_auth/cli.py:26
msgid "no face visible"
msgstr "aucun visage visible"

#: src/facial_auth/cli.py:26
msgid "several faces visible"
msgstr "plusieurs visages visibles"

#: src/facial_auth/cli.py:27
msgid "too far: come closer"
msgstr "trop loin : rapprochez-vous"

#: src/facial_auth/cli.py:27
msgid "too dark"
msgstr "trop sombre"

#: src/facial_auth/cli.py:28
msgid "too bright"
msgstr "trop lumineux"

#: src/facial_auth/cli.py:28
msgid "blurry: stay still"
msgstr "flou : ne bougez pas"

#: src/facial_auth/cli.py:62
msgid "Not authorized (an administrator must approve this action)."
msgstr "Non autorisé (un administrateur doit approuver cette action)."

#: src/facial_auth/cli.py:63
msgid ""
"Cannot ask polkit whether you may do this (is polkitd installed and "
"running?)."
msgstr ""
"Impossible d'interroger polkit pour savoir si vous y êtes autorisé (polkitd "
"est-il installé et démarré ?)."

#: src/facial_auth/cli.py:64
msgid ""
"The facial-authd service is not running (try: sudo systemctl start facial-"
"authd)."
msgstr ""
"Le service facial-authd n'est pas démarré (essayez : sudo systemctl start "
"facial-authd)."

#: src/facial_auth/cli.py:65
msgid "No suitable camera found."
msgstr "Aucune caméra utilisable n'a été trouvée."

#: src/facial_auth/cli.py:66
msgid "The camera is in use by another application."
msgstr "La caméra est utilisée par une autre application."

#: src/facial_auth/cli.py:67 src/facial_auth/gui/app.py:149
msgid "Face models are missing: run 'sudo facial-auth fetch-models'."
msgstr ""
"Les modèles de reconnaissance sont absents : exécutez « sudo facial-auth "
"fetch-models »."

#: src/facial_auth/cli.py:68
msgid "Not enough usable photos."
msgstr "Pas assez de photos exploitables."

#: src/facial_auth/cli.py:69
msgid "The photos do not all show the same person."
msgstr "Les photos ne montrent pas toutes la même personne."

#: src/facial_auth/cli.py:70
msgid "No face is linked to this account."
msgstr "Aucun visage n'est lié à ce compte."

#: src/facial_auth/cli.py:79
#, python-format
msgid "Face authentication: %s"
msgstr "Authentification faciale : %s"

#: src/facial_auth/cli.py:79
msgid "enabled"
msgstr "activée"

#: src/facial_auth/cli.py:79
msgid "disabled"
msgstr "désactivée"

#: src/facial_auth/cli.py:80 src/facial_auth/cli.py:468
#, python-format
msgid "Camera: %s"
msgstr "Caméra : %s"

#: src/facial_auth/cli.py:80 src/facial_auth/cli.py:468
#: src/facial_auth/cli.py:484
msgid "none"
msgstr "aucune"

#: src/facial_auth/cli.py:81
#, python-format
msgid "Models: %s"
msgstr "Modèles : %s"

#: src/facial_auth/cli.py:81
msgid "ok"
msgstr "ok"

#: src/facial_auth/cli.py:81
#, python-format
msgid "missing: %s"
msgstr "manquants : %s"

#: src/facial_auth/cli.py:82
#, python-format
msgid "Lid: %s"
msgstr "Capot : %s"

#: src/facial_auth/cli.py:82
msgid "closed"
msgstr "fermé"

#: src/facial_auth/cli.py:82
msgid "open"
msgstr "ouvert"

#: src/facial_auth/cli.py:83
msgid "Accounts:"
msgstr "Comptes :"

#: src/facial_auth/cli.py:85
#, python-format
msgid "%d face(s), %s"
msgstr "%d visage(s), %s"

#: src/facial_auth/cli.py:85
msgid "on"
msgstr "activé"

#: src/facial_auth/cli.py:85
msgid "off"
msgstr "désactivé"

#: src/facial_auth/cli.py:85
msgid "no face"
msgstr "aucun visage"

#: src/facial_auth/cli.py:86
#, python-format
msgid " [locked out for %ds]"
msgstr " [verrouillé pendant %d s]"

#: src/facial_auth/cli.py:93
msgid " (not a capture device)"
msgstr " (n'est pas un périphérique de capture)"

#: src/facial_auth/cli.py:93
msgid " (virtual)"
msgstr " (virtuelle)"

#: src/facial_auth/cli.py:101
msgid "No face is linked to any account."
msgstr "Aucun visage n'est lié à un compte."

#: src/facial_auth/cli.py:112
#, python-format
msgid "Using the %s camera."
msgstr "Utilisation de la caméra %s."

#: src/facial_auth/cli.py:115
#, python-format
msgid "Taking %d photos. %s..."
msgstr "Prise de %d photos. %s..."

#: src/facial_auth/cli.py:133
#, python-format
msgid "  photo %d/%d taken"
msgstr "  photo %d/%d prise"

#: src/facial_auth/cli.py:144
#, python-format
msgid ""
"Linking this face to the account '%s' (administrator approval required)..."
msgstr ""
"Liaison de ce visage au compte « %s » (approbation d'un administrateur "
"requise)..."

#: src/facial_auth/cli.py:147
#, python-format
msgid "Done: face '%s' (%s) is now linked to %s."
msgstr "Terminé : le visage « %s » (%s) est maintenant lié à %s."

#: src/facial_auth/cli.py:148
msgid ""
"You can now sign in with your face; the password always remains available."
msgstr ""
"Vous pouvez désormais vous connecter avec votre visage ; le mot de passe "
"reste toujours disponible."

#: src/facial_auth/cli.py:156
msgid "Not enough good photos were captured."
msgstr "Pas assez de bonnes photos ont été capturées."

#: src/facial_auth/cli.py:158 src/facial_auth/cli.py:170
msgid "Face"
msgstr "Visage"

#: src/facial_auth/cli.py:175
msgid "Face removed."
msgstr "Visage supprimé."

#: src/facial_auth/cli.py:181
#, python-format
msgid "Remove every face of %s? [y/N] "
msgstr "Supprimer tous les visages de %s ? [o/N] "

#: src/facial_auth/cli.py:183
#, python-format
msgid "%d face(s) removed."
msgstr "%d visage(s) supprimé(s)."

#: src/facial_auth/cli.py:190
msgid "Face authentication enabled for this account."
msgstr "Authentification faciale activée pour ce compte."

#: src/facial_auth/cli.py:190
msgid "Face authentication disabled for this account."
msgstr "Authentification faciale désactivée pour ce compte."

#: src/facial_auth/cli.py:197
msgid ""
"Turn your head clearly to your right, then to your left, then look at the "
"camera."
msgstr ""
"Tournez nettement la tête vers votre droite, puis vers votre gauche, puis "
"regardez la caméra."

#: src/facial_auth/cli.py:198
msgid ""
"Turn your head clearly to your left, then to your right, then look at the "
"camera."
msgstr ""
"Tournez nettement la tête vers votre gauche, puis vers votre droite, puis "
"regardez la caméra."

#: src/facial_auth/cli.py:208
msgid "Good. Now look straight at the camera."
msgstr "Bien. Maintenant, regardez la caméra bien en face."

#: src/facial_auth/cli.py:215
msgid ""
"You did not turn far enough: turn your head clearly (about 15 to 20 degrees, "
"as if looking at the edge of the screen) to each side."
msgstr ""
"Vous n'avez pas tourné assez loin : tournez nettement la tête (environ 15 à "
"20 degrés, comme pour regarder le bord de l'écran) de chaque côté."

#: src/facial_auth/cli.py:217
msgid ""
"A movement was seen, but not towards the side that was asked first: turn "
"your head to your own left or right as told (if the picture is mirrored, set "
"liveness.mirror = true)."
msgstr ""
"Un mouvement a été vu, mais pas d'abord du côté demandé : tournez la tête "
"vers votre propre gauche ou droite, comme indiqué (si l'image est en miroir, "
"mettez liveness.mirror = true)."

#: src/facial_auth/cli.py:220
msgid ""
"The turn was too quick to be followed: pause for half a second at each side."
msgstr ""
"Le mouvement était trop rapide pour être suivi : marquez une pause d'une "
"demi-seconde de chaque côté."

#: src/facial_auth/cli.py:221
msgid ""
"The first turn was seen, not the second: turn clearly to the other side too, "
"without hurrying and without stopping half way."
msgstr ""
"Le premier mouvement a été vu, pas le second : tournez aussi nettement de "
"l'autre côté, sans vous presser et sans vous arrêter à mi-course."

#: src/facial_auth/cli.py:223
msgid ""
"Both turns were seen, but your face was not recognised again looking at the "
"camera: look straight at it, in good light (a stricter recognition level "
"makes this harder)."
msgstr ""
"Les deux mouvements ont été vus, mais votre visage n'a pas été reconnu de "
"nouveau en regardant la caméra : regardez-la bien en face, avec une bonne "
"lumière (un niveau de reconnaissance plus strict rend cela plus difficile)."

#: src/facial_auth/cli.py:226
msgid "Your face left the picture during the movement."
msgstr "Votre visage est sorti de l'image pendant le mouvement."

#: src/facial_auth/cli.py:227
msgid "The face seen during the movement was not yours."
msgstr "Le visage vu pendant le mouvement n'était pas le vôtre."

#: src/facial_auth/cli.py:228
msgid ""
"Not enough detail could be followed on your face: more light, or come closer."
msgstr ""
"Pas assez de détails à suivre sur votre visage : plus de lumière, ou "
"rapprochez-vous."

#: src/facial_auth/cli.py:229
msgid "The face looked flat, like a picture."
msgstr "Le visage paraissait plat, comme une image."

#: src/facial_auth/cli.py:258 src/facial_auth/gui/app.py:310
msgid "Look at the camera..."
msgstr "Regardez la caméra..."

#: src/facial_auth/cli.py:268
#, python-format
msgid "Recognised (%s camera, similarity %.2f, %.1fs)."
msgstr "Reconnu (caméra %s, similarité %.2f, %.1f s)."

#: src/facial_auth/cli.py:270
#, python-format
msgid "Not recognised (%s)."
msgstr "Non reconnu (%s)."

#: src/facial_auth/cli.py:276
#, python-format
msgid "Head-turn measurements: %s"
msgstr "Mesures du défi de tête : %s"

#: src/facial_auth/cli.py:282 src/facial_auth/gui/app.py:282
msgid ""
"Infrared camera check: first look at the camera, with nothing in front of "
"it..."
msgstr ""
"Vérification de la caméra infrarouge : regardez d'abord la caméra, sans rien "
"devant..."

#: src/facial_auth/cli.py:286 src/facial_auth/gui/app.py:285
msgid ""
"Now hold a phone close to the lens, screen on, showing a bright white page, "
"for about 5 seconds."
msgstr ""
"Maintenant, tenez un téléphone près de l'objectif, écran allumé, affichant "
"une page blanche lumineuse, pendant environ 5 secondes."

#: src/facial_auth/cli.py:293
#, python-format
msgid "✔ %s does not see the phone screen: it is a real infrared camera."
msgstr ""
"✔ %s ne voit pas l'écran du téléphone : c'est bien une caméra infrarouge."

#: src/facial_auth/cli.py:294
msgid "Services that require infrared accept it from now on."
msgstr "Les services qui exigent l'infrarouge l'acceptent désormais."

#: src/facial_auth/cli.py:297
#, python-format
msgid ""
"✘ %s saw the phone screen: it is not an infrared camera, a photograph shown "
"on a phone would fool it."
msgstr ""
"✘ %s a vu l'écran du téléphone : ce n'est pas une caméra infrarouge, une "
"photo affichée sur un téléphone la tromperait."

#: src/facial_auth/cli.py:299
msgid ""
"Services that require infrared will not accept it. Use another camera, or "
"allow the colour webcam knowingly (docs/SECURITY.md)."
msgstr ""
"Les services qui exigent l'infrarouge ne l'accepteront pas. Utilisez une "
"autre caméra, ou autorisez sciemment la webcam couleur (docs/SECURITY.md)."

#: src/facial_auth/cli.py:302
msgid "Nothing seems to have been held in front of the camera."
msgstr "Rien ne semble avoir été présenté devant la caméra."

#: src/facial_auth/cli.py:303
msgid "The camera gave too few pictures."
msgstr "La caméra a fourni trop peu d'images."

#: src/facial_auth/cli.py:303
msgid "The result is ambiguous."
msgstr "Le résultat est ambigu."

#: src/facial_auth/cli.py:304
#, python-format
msgid ""
"? %s Try again, with the screen close to the lens and at full brightness."
msgstr "? %s Recommencez, l'écran près de l'objectif et à pleine luminosité."

#: src/facial_auth/cli.py:320
#, python-format
msgid "Service %s: %s"
msgstr "Service %s : %s"

#: src/facial_auth/cli.py:354
msgid "Run this command as root: sudo facial-auth fetch-models"
msgstr "Exécutez cette commande en root : sudo facial-auth fetch-models"

#: src/facial_auth/cli.py:365
#, python-format
msgid "Download failed: %s"
msgstr "Échec du téléchargement : %s"

#: src/facial_auth/cli.py:368
#, python-format
msgid "installed %s"
msgstr "installé : %s"

#: src/facial_auth/cli.py:377
msgid "Run this command as root: sudo facial-auth purge-orphans"
msgstr "Exécutez cette commande en root : sudo facial-auth purge-orphans"

#: src/facial_auth/cli.py:386
msgid "No orphaned face data."
msgstr "Aucune donnée de visage orpheline."

#: src/facial_auth/cli.py:388
msgid "Face data that no longer belongs to the account it was enrolled for:"
msgstr "Données de visage qui n'appartiennent plus au compte pour lequel elles ont été enregistrées :"

#: src/facial_auth/cli.py:390
#, python-format
msgid "the account is now called '%s'"
msgstr "le compte s'appelle maintenant « %s »"

#: src/facial_auth/cli.py:390
msgid "no such account"
msgstr "ce compte n'existe plus"

#: src/facial_auth/cli.py:391
#, python-format
msgid "enrolled for '%s'"
msgstr "enregistré pour « %s »"

#: src/facial_auth/cli.py:393
msgid "Nothing was removed (--dry-run)."
msgstr "Rien n'a été supprimé (--dry-run)."

#: src/facial_auth/cli.py:397
msgid "Run again with --yes to delete this data."
msgstr "Relancez avec --yes pour supprimer ces données."

#: src/facial_auth/cli.py:399
msgid "Delete this data? [y/N] "
msgstr "Supprimer ces données ? [o/N] "

#: src/facial_auth/cli.py:401
#, python-format
msgid "%d record(s) removed."
msgstr "%d enregistrement(s) supprimé(s)."

#: src/facial_auth/cli.py:421
msgid "not installed"
msgstr "non installé"

#: src/facial_auth/cli.py:429
#, python-format
msgid "%s crashed the loader (signal %d)"
msgstr "%s a fait planter le chargeur (signal %d)"

#: src/facial_auth/cli.py:430
#, python-format
msgid "%s cannot be loaded"
msgstr "%s ne peut pas être chargé"

#: src/facial_auth/cli.py:448
#, python-format
msgid "Models (%s + %s) in %s"
msgstr "Modèles (%s + %s) dans %s"

#: src/facial_auth/cli.py:449
msgid "sudo facial-auth fetch-models   (offline: --from DIR)"
msgstr "sudo facial-auth fetch-models   (hors ligne : --from DOSSIER)"

#: src/facial_auth/cli.py:453
#, python-format
msgid "PAM socket %s"
msgstr "Socket PAM %s"

#: src/facial_auth/cli.py:453
msgid "sudo systemctl enable --now facial-authd.socket"
msgstr "sudo systemctl enable --now facial-authd.socket"

#: src/facial_auth/cli.py:457
msgid "PAM module loads"
msgstr "Le module PAM se charge"

#: src/facial_auth/cli.py:457
#, python-format
msgid "PAM module: %s"
msgstr "Module PAM : %s"

#: src/facial_auth/cli.py:458
msgid "sudo apt install --reinstall facial-auth"
msgstr "sudo apt install --reinstall facial-auth"

#: src/facial_auth/cli.py:459
msgid "PAM stack integration (common-auth)"
msgstr "Intégration à la pile PAM (common-auth)"

#: src/facial_auth/cli.py:459
msgid "sudo pam-auth-update --enable facial-auth"
msgstr "sudo pam-auth-update --enable facial-auth"

#: src/facial_auth/cli.py:461
msgid "The damaged module is in the authentication stack"
msgstr "Le module endommagé figure dans la pile d'authentification"

#: src/facial_auth/cli.py:462
msgid ""
"sudo pam-auth-update --package --remove facial-auth   (password login is "
"unaffected)"
msgstr ""
"sudo pam-auth-update --package --remove facial-auth   (la connexion par mot "
"de passe n'est pas affectée)"

#: src/facial_auth/cli.py:463
msgid "polkit policy installed"
msgstr "Politique polkit installée"

#: src/facial_auth/cli.py:467
#, python-format
msgid "Daemon reachable (up %ds)"
msgstr "Démon joignable (actif depuis %d s)"

#: src/facial_auth/cli.py:469
msgid ""
"Plug a camera, or check that the 'facial-auth' user is in the 'video' group"
msgstr ""
"Branchez une caméra, ou vérifiez que l'utilisateur « facial-auth » est dans "
"le groupe « video »"

#: src/facial_auth/cli.py:471
msgid ""
"Only a colour webcam: a photograph shown on a phone fools it, so by default "
"no service uses the face."
msgstr ""
"Seulement une webcam couleur : une photo affichée sur un téléphone la "
"trompe, donc par défaut aucun service n'utilise le visage."

#: src/facial_auth/cli.py:473
msgid "An infrared camera is recommended (see docs/SECURITY.md)"
msgstr "Une caméra infrarouge est recommandée (voir docs/SECURITY.md)"

#: src/facial_auth/cli.py:477
msgid ""
"This \"infrared\" camera sees a phone screen: a photograph on a phone would "
"fool it"
msgstr ""
"Cette caméra « infrarouge » voit un écran de téléphone : une photo sur un "
"téléphone la tromperait"

#: src/facial_auth/cli.py:478
msgid "Use another camera, or set camera.require_ir_check = false knowingly"
msgstr ""
"Utilisez une autre caméra, ou mettez camera.require_ir_check = false en "
"connaissance de cause"

#: src/facial_auth/cli.py:480
msgid "Infrared camera verified"
msgstr "Caméra infrarouge vérifiée"

#: src/facial_auth/cli.py:481
msgid ""
"facial-auth check-camera   (until then, no service that needs infrared uses "
"the face)"
msgstr ""
"facial-auth check-camera   (d'ici là, aucun service exigeant l'infrarouge "
"n'utilise le visage)"

#: src/facial_auth/cli.py:482
msgid "Daemon sees the models"
msgstr "Le démon voit les modèles"

#: src/facial_auth/cli.py:484
#, python-format
msgid "Linked accounts: %s"
msgstr "Comptes liés : %s"

#: src/facial_auth/cli.py:485
msgid "facial-auth add --user NAME   (or open the 'Face Login' settings app)"
msgstr ""
"facial-auth add --user NOM   (ou ouvrez l'application « Connexion par le "
"visage »)"

#: src/facial_auth/cli.py:487
msgid "Daemon reachable"
msgstr "Démon joignable"

#: src/facial_auth/cli.py:492
msgid "Face authentication for Ubuntu"
msgstr "Authentification faciale pour Ubuntu"

#: src/facial_auth/cli.py:499
msgid "account (default: you)"
msgstr "compte (par défaut : vous)"

#: src/facial_auth/cli.py:503
msgid "show the state of the service"
msgstr "afficher l'état du service"

#: src/facial_auth/cli.py:504
msgid "list detected cameras"
msgstr "lister les caméras détectées"

#: src/facial_auth/cli.py:505
msgid "list linked faces"
msgstr "lister les visages liés"

#: src/facial_auth/cli.py:506
msgid "take photos with the camera and link the face to an account"
msgstr "prendre des photos avec la caméra et lier le visage à un compte"

#: src/facial_auth/cli.py:510
msgid "link a face from photos (e.g. taken with the Camera app)"
msgstr ""
"lier un visage à partir de photos (p. ex. prises avec l'application Caméra)"

#: src/facial_auth/cli.py:514
msgid "remove one face"
msgstr "supprimer un visage"

#: src/facial_auth/cli.py:516
msgid "remove every face of an account"
msgstr "supprimer tous les visages d'un compte"

#: src/facial_auth/cli.py:518
msgid "enable face authentication for an account"
msgstr "activer l'authentification faciale pour un compte"

#: src/facial_auth/cli.py:519
msgid "disable face authentication for an account"
msgstr "désactiver l'authentification faciale pour un compte"

#: src/facial_auth/cli.py:520
msgid "check that the infrared camera does not see a phone screen"
msgstr "vérifie que la caméra infrarouge ne voit pas un écran de téléphone"

#: src/facial_auth/cli.py:521
msgid "check that the camera recognises you"
msgstr "vérifier que la caméra vous reconnaît"

#: src/facial_auth/cli.py:524
msgid "also print the head-turn measurements (to tune liveness.challenge_turn)"
msgstr ""
"affiche aussi les mesures du défi de tête (pour régler liveness."
"challenge_turn)"

#: src/facial_auth/cli.py:525
msgid "show or set where the face may be used (sudo, gdm-password...)"
msgstr ""
"afficher ou régler où le visage peut être utilisé (sudo, gdm-password...)"

#: src/facial_auth/cli.py:528
msgid "show or change a setting (e.g. recognition.threshold 0.5)"
msgstr "afficher ou modifier un réglage (p. ex. recognition.threshold 0.5)"

#: src/facial_auth/cli.py:531
