# Build / packaging
/build/
/builddir/
*.o
*.so
*.mo
/debian/.debhelper/
/debian/*.debhelper*
/debian/*.substvars
/debian/files
/debian/facial-auth/
/debian/facial-auth-gtk/
/debian/debhelper-build-stamp
/obj-*/
../*.deb
