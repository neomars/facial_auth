#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
configure)
    # The module enters the authentication stack only once it has been loaded
    # successfully in a throw-away process.  PAM ignores a module that cannot be
    # loaded, but nothing can ignore one that kills its host (a corrupted or
    # truncated file makes the loader die with SIGBUS inside sudo, su, login...).
    # A module that fails this test is left out, and removed if it was already in.
    module="$(ls /usr/lib/*/security/pam_facial_auth.so 2>/dev/null | head -n 1 || true)"
    module_loads=no
    if [ -n "$module" ] && python3 -c '
import ctypes, sys
lib = ctypes.CDLL(sys.argv[1])
lib.pam_sm_authenticate, lib.pam_sm_setcred' "$module" >/dev/null 2>&1; then
        module_loads=yes
    fi
    # Add the profile to /etc/pam.d/common-auth (a no-op for accounts without a
    # linked face: the module returns at once).
    if command -v pam-auth-update >/dev/null 2>&1; then
        if [ "$module_loads" = yes ]; then
            pam-auth-update --package || true
        else
            echo "facial-auth: the PAM module cannot be loaded: it is NOT enabled." >&2
            echo "facial-auth: password login is unchanged; reinstall the package." >&2
            pam-auth-update --package --remove facial-auth || true
        fi
    fi
    # 1.1.0 changed two defaults: every service now needs an infrared camera that was *verified* once
    # (a photograph shown on a phone must not unlock a session), and a head-turn test follows the
    # recognition.  Say so, once, to whoever upgrades.
    if [ -n "${2:-}" ] && dpkg --compare-versions "$2" lt 1.1.0~; then
        echo "facial-auth: the face is now harder to fool with a photograph:" >&2
        echo "facial-auth:  - an infrared camera must be verified once: run 'facial-auth check-camera';" >&2
        echo "facial-auth:  - a colour webcam is no longer accepted unless allowed ([services] in /etc/facial-auth/facial-auth.conf);" >&2
        echo "facial-auth:  - once the face is recognised, a head-turn test follows." >&2
        echo "facial-auth: until then the face is simply not used: the password is unaffected." >&2
    fi
    # Create/own the state directory in case systemd did not yet.
    install -d -o facial-auth -g facial-auth -m 0755 /var/lib/facial-auth 2>/dev/null || true
    # Face models (SHA-256 verified). Best effort: offline installs run it later.
    if [ ! -e /usr/share/facial-auth/models/.installed ] && command -v facial-auth >/dev/null 2>&1; then
        if facial-auth fetch-models >/dev/null 2>&1; then
            touch /usr/share/facial-auth/models/.installed
        else
            echo "facial-auth: the face models could not be downloaded now." >&2
            echo "facial-auth: run 'sudo facial-auth fetch-models' when online (or --from DIR)." >&2
        fi
    fi
    ;;
esac
exit 0
